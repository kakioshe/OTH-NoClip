<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RestoreSources></RestoreSources>
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == ''">$(GameDir)\MelonLoader</MelonLoaderDir>
  </PropertyGroup>
  <Target Name="ValidateBuildDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DotNet6RuntimeDir)' == '' Or !Exists('$(DotNet6RuntimeDir)\System.Private.CoreLib.dll')" Text="Set DotNet6RuntimeDir to your installed Microsoft.NETCore.App 6.0.x runtime directory. See README.md." />
    <Error Condition="!Exists('$(MelonLoaderDir)\Il2CppAssemblies\Assembly-CSharp.dll') Or !Exists('$(MelonLoaderDir)\net6\MelonLoader.dll')" Text="Set GameDir or MelonLoaderDir to an initialized MelonLoader game installation. See README.md." />
  </Target>
  <Target Name="StageDevelopmentPlugin" AfterTargets="Build" Condition="'$(DevelopmentPluginDir)' != ''">
    <MakeDir Directories="$(DevelopmentPluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevelopmentPluginDir)" />
  </Target>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="$(DotNet6RuntimeDir)\*.dll" />
    <Reference Include="$(MelonLoaderDir)\Il2CppAssemblies\*.dll" />
    <Reference Include="$(MelonLoaderDir)\net6\*.dll" />
  </ItemGroup>
</Project>
