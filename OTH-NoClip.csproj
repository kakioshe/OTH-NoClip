<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RestoreSources></RestoreSources>
    <SupportDir Condition="'$(SupportDir)' == ''">$(MSBuildProjectDirectory)\..\support</SupportDir>
  </PropertyGroup>
  <Target Name="ValidateBuildDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DotNet6RuntimeDir)' == '' Or !Exists('$(DotNet6RuntimeDir)\System.Private.CoreLib.dll')" Text="Set DotNet6RuntimeDir to your installed Microsoft.NETCore.App 6.0.x runtime directory. See README.md." />
    <Error Condition="!Exists('$(SupportDir)\interop\Assembly-CSharp.dll') Or !Exists('$(SupportDir)\BepInEx-Setup\BepInEx\core\BepInEx.Core.dll')" Text="Set SupportDir to a support folder containing the game interop and BepInEx core assemblies. See README.md." />
  </Target>
  <Target Name="StageDevelopmentPlugin" AfterTargets="Build" Condition="'$(DevelopmentPluginDir)' != ''">
    <MakeDir Directories="$(DevelopmentPluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevelopmentPluginDir)" />
  </Target>
  <ItemGroup>
    <Reference Include="$(DotNet6RuntimeDir)\*.dll" />
    <Reference Include="$(SupportDir)\interop\*.dll" />
    <Reference Include="$(SupportDir)\BepInEx-Setup\BepInEx\core\*.dll" />
  </ItemGroup>
</Project>
